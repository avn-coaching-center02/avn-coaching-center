*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f7fb;
color:#222;
}

.header{
background:#0b5ed7;
color:#fff;
text-align:center;
padding:30px 15px;
}

.header h1{
font-size:34px;
margin-bottom:10px;
}

.header p{
font-size:18px;
}

nav{
background:#083b8a;
padding:15px;
text-align:center;
}

nav a{
color:#fff;
text-decoration:none;
margin:10px;
font-weight:bold;
}

.container{
width:95%;
max-width:1000px;
margin:auto;
padding:20px;
}

.card{
background:#fff;
padding:20px;
margin:20px 0;
border-radius:10px;
box-shadow:0 2px 8px rgba(0,0,0,.15);
}

.btn{
display:inline-block;
background:#198754;
color:#fff;
padding:12px 25px;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

.btn:hover{
background:#146c43;
}

input,select,button{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid #ccc;
border-radius:6px;
font-size:16px;
}

button{
background:#0b5ed7;
color:#fff;
border:none;
cursor:pointer;
}

button:hover{
background:#084298;
}

table{
width:100%;
border-collapse:collapse;
margin-top:20px;
}

table th{
background:#0b5ed7;
color:#fff;
padding:10px;
}

table td{
padding:10px;
border:1px solid #ddd;
}

footer{
background:#0b5ed7;
color:#fff;
text-align:center;
padding:20px;
margin-top:30px;
}

.pass{
color:green;
font-weight:bold;
}

.fail{
color:red;
font-weight:bold;
}

.awaited{
color:#ff9800;
font-weight:bold;
}
